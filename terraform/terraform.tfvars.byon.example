# Bring-your-own-workspaces path: copy to terraform.tfvars (gitignored) and make it yours. Only
# the function app deploys (no test workspace), and its identity is granted Log Analytics Reader
# on exactly the workspaces you list, whose GUIDs become the run_kql allow-list. The tool refuses
# any workspace off the list before RBAC even gets a say.

owner       = "craig@craigthacker.dev"
cost_centre = "1888/67"

short = "ldo"
loc   = "uks"
env   = "prd"

deploy_test_law = false

workspace_scopes = [
  "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-my-soc/providers/Microsoft.OperationalInsights/workspaces/law-my-sentinel",
]
