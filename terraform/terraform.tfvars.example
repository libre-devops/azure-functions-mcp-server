# Standalone path: copy to terraform.tfvars (gitignored) and make it yours. Every value has a
# sensible default, so only set what differs for you. This path seeds a small Log Analytics
# workspace so the run_kql tool has something real to answer the moment the deploy lands; the
# smoke queries it. For a deployment against workspaces you already have, start from
# terraform.tfvars.byon.example instead.

owner       = "craig@craigthacker.dev"
cost_centre = "1888/67"

short = "ldo"
loc   = "uks"
env   = "dev"

deploy_test_law = true
